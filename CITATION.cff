    given-names: Danilo
    orcid: "https://orcid.org/0000-0003-2767-5764"
type: software
license: MIT
repository-code: "https://github.com/danilodsp/AFX"
url: "https://danilopena.com/AFX/"
version: 0.3.0
keywords:
