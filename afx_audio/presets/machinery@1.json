{
  "preset": {"name": "machinery", "version": 1},
  "title": "Machinery & Condition Monitoring",
  "description": "Vibration/acoustic condition-monitoring set for fault detection on rotating machinery (bearings, pumps, fans, valves). Emphasizes impulsiveness (crest factor, kurtosis), signal complexity (Hjorth mobility/complexity) and spectral shape shifts that flag anomalies.",
  "sample_rate": 16000,
  "features": {
    "rms_energy": {"frame_size": 1024, "hop_length": 512, "center": true},
    "crest_factor": {"frame_size": 1024, "hop_length": 512, "center": true},
    "kurtosis": {"frame_size": 1024, "hop_length": 512, "center": true, "fisher": true},
    "mobility": {"frame_size": 1024, "hop_length": 512, "center": true},
    "complexity": {"frame_size": 1024, "hop_length": 512, "center": true},
    "spectral_centroid": {"frame_size": 1024, "hop_length": 512, "center": true},
    "spectral_bandwidth": {"frame_size": 1024, "hop_length": 512, "center": true},
    "spectral_flatness": {"frame_size": 1024, "hop_length": 512, "center": true},
    "spectral_entropy": {"frame_size": 1024, "hop_length": 512, "center": true},
    "spectral_flux": {"frame_size": 1024, "hop_length": 512, "center": true},
    "mfcc": {"n_mfcc": 13, "frame_size": 1024, "hop_length": 512, "n_mels": 128, "fmin": 0.0, "fmax": null, "center": true, "top_db": 80.0},
    "hnr": {"frame_size": 1024, "hop_length": 512, "center": true, "fmin": 50.0, "fmax": 2000.0}
  },
  "aggregation": "advanced_summary"
}
